# ============================================================
# Smart Buy — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# VS Code (keep shared settings, ignore personal state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# IDE
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Large raw data — regenerate with src/ingestion/downloaders.py
data/raw/*.xls
data/raw/*.xlsx

# Never commit credentials or secrets
.env
*.key
*.pem
